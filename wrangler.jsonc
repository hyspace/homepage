{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "hyspace-homepage",
    "compatibility_date": "2026-09-16",
    "workers_dev": true,
    "assets": {
        "directory": "./public",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none"
    }
}
